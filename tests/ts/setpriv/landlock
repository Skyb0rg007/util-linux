TS_TOPDIR="${0%/*}/../.."
TS_DESC="setpriv landlock"

. "$TS_TOPDIR"/functions.sh
ts_init "$*"

[[ "$COVERAGE" = yes ]] && ts_skip "does not work with coverage"

ts_check_test_command "$TS_CMD_SETPRIV"

"$TS_CMD_SETPRIV" --landlock-access fs \
	--landlock-rule path-beneath:execute:/ \
	--landlock-rule path-beneath:read-file:/ \
	true \
	|| ts_skip "no landlock support in setpriv"

ts_init_subtest "nothing-allowed"
"$TS_CMD_SETPRIV" --landlock-access fs true &> "$TS_OUTPUT"
ts_finalize_subtest

ts_init_subtest "partial-access-fail"
"$TS_CMD_SETPRIV" --landlock-access \
	fs:write cp /dev/null /dev/zero \
	&> "$TS_OUTPUT"
ts_finalize_subtest

ts_init_subtest "partial-access-success"
"$TS_CMD_SETPRIV" \
	--landlock-access fs:write --landlock-rule path-beneath:write:/dev/zero \
	cp /dev/null /dev/zero \
	&> "$TS_OUTPUT"
ts_finalize_subtest

ts_init_subtest "combined-access"
"$TS_CMD_SETPRIV" --landlock-access fs:execute,read-file \
	--landlock-rule path-beneath:execute,read-file:/ \
	true \
	&> "$TS_OUTPUT"
ts_finalize_subtest

ts_init_subtest "wildcard-access"
"$TS_CMD_SETPRIV" --landlock-access fs \
	--landlock-rule path-beneath::/ \
	true \
	&> "$TS_OUTPUT"
ts_finalize_subtest

ts_init_subtest "wildcard-partial-access"
"$TS_CMD_SETPRIV" --landlock-access fs:execute \
	--landlock-rule path-beneath::/ \
	true \
	&> "$TS_OUTPUT"
ts_finalize_subtest

ts_init_subtest "wildcard-partial-access-reversed"
"$TS_CMD_SETPRIV" --landlock-rule path-beneath::/ \
	--landlock-access fs:execute \
	true \
	&> "$TS_OUTPUT"
ts_finalize_subtest

# The "net" access category needs landlock ABI 4.
if "$TS_CMD_SETPRIV" --landlock-access net true &> /dev/null; then

	ts_init_subtest "net-rule-without-access"
	"$TS_CMD_SETPRIV" --landlock-rule net-port:bind-tcp:8080 \
		true \
		&> "$TS_OUTPUT"
	ts_finalize_subtest

	ts_init_subtest "net-invalid-port"
	"$TS_CMD_SETPRIV" --landlock-access net \
		--landlock-rule net-port:bind-tcp:99999 \
		true \
		&> "$TS_OUTPUT"
	ts_finalize_subtest

	ts_init_subtest "net-combined-access"
	"$TS_CMD_SETPRIV" --landlock-access fs:execute --landlock-access net \
		--landlock-rule path-beneath:execute:/ \
		--landlock-rule net-port:connect-tcp:443 \
		true \
		&> "$TS_OUTPUT"
	ts_finalize_subtest

	# A blocked and a refused connection both just make bash fail, so the
	# two are told apart by the errno. Whether anything listens on the port
	# does not matter, only landlock returns EACCES. Skip the subtests when
	# bash was built without /dev/tcp redirection support.
	if ! bash -c 'exec 3<>/dev/tcp/127.0.0.1/9' 2>&1 \
			| grep -qi 'no such file or directory'; then

		ts_init_subtest "net-connect-blocked"
		if "$TS_CMD_SETPRIV" --landlock-access net:connect-tcp \
				bash -c 'exec 3<>/dev/tcp/127.0.0.1/9' 2>&1 \
				| grep -qi 'permission denied'; then
			echo "connect blocked" &> "$TS_OUTPUT"
		else
			echo "connect allowed" &> "$TS_OUTPUT"
		fi
		ts_finalize_subtest

		ts_init_subtest "net-connect-allowed"
		if "$TS_CMD_SETPRIV" --landlock-access net:connect-tcp \
				--landlock-rule net-port:connect-tcp:9 \
				bash -c 'exec 3<>/dev/tcp/127.0.0.1/9' 2>&1 \
				| grep -qi 'permission denied'; then
			echo "connect blocked" &> "$TS_OUTPUT"
		else
			echo "connect allowed" &> "$TS_OUTPUT"
		fi
		ts_finalize_subtest
	fi
fi

# The "scoped" access category needs landlock ABI 6.
if "$TS_CMD_SETPRIV" --landlock-access scoped true &> /dev/null; then

	# setpriv exec()s the shell, so $PPID is the test's own shell, which
	# stays outside of the landlock domain.
	ts_init_subtest "scoped-signal-blocked"
	if "$TS_CMD_SETPRIV" --landlock-access scoped:signal \
			bash -c 'kill -0 $PPID' &> /dev/null; then
		echo "signal allowed" &> "$TS_OUTPUT"
	else
		echo "signal blocked" &> "$TS_OUTPUT"
	fi
	ts_finalize_subtest

	ts_init_subtest "scoped-signal-allowed"
	if "$TS_CMD_SETPRIV" --landlock-access scoped:abstract-unix-socket \
			bash -c 'kill -0 $PPID' &> /dev/null; then
		echo "signal allowed" &> "$TS_OUTPUT"
	else
		echo "signal blocked" &> "$TS_OUTPUT"
	fi
	ts_finalize_subtest
fi

ts_finalize
